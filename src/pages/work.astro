---
import Base from '../layouts/Base.astro';
import Timeline from '../features/work/components/Timeline';
import TechnologyLoops from '../features/work/components/TechnologyLoops';
import { getProjects } from '../lib/content';
import workTimelineMock from '../data/workTimelineMock';
import { withBasePath } from '../lib/sitePath';

const projects = getProjects();
---

<Base title="Work" fullBleed htmlClass="work-page">
  <div class="work-redesign" data-work-page>
    <div class="work-redesign__progress" data-work-progress aria-hidden="true">
      <span data-work-progress-fill></span>
    </div>

    <div class="work-redesign__main">
      <section id="work-hero" class="work-redesign__hero" data-work-section="hero" aria-labelledby="work-title">
        <div class="work-redesign__hero-grid">
          <div class="work-redesign__hero-copy">
            <p class="work-redesign__eyebrow" data-work-reveal="eyebrow">WORK / 2026</p>
            <h1 id="work-title" class="work-redesign__title" data-work-reveal="heading">
              Systems with a human scale.
            </h1>
            <p class="work-redesign__lede" data-work-reveal="lede">
              Selected work across interfaces, backend systems, and agent tools.
            </p>
          </div>

          <div class="work-redesign__hero-mark" data-work-hero-mark aria-hidden="true">
            <span class="work-redesign__hero-mark-ring"></span>
            <span class="work-redesign__hero-mark-dot"></span>
            <span class="work-redesign__hero-mark-label">R / 26</span>
          </div>
        </div>

        <a class="work-redesign__scroll-link" href="#work-profile" data-work-reveal="scroll">
          <span>Scroll to explore</span>
          <span aria-hidden="true">↓</span>
        </a>
      </section>

      <section id="work-profile" class="work-redesign__section work-redesign__section--profile" data-work-section="profile" aria-labelledby="work-profile-title">
        <div class="work-redesign__section-head" data-work-reveal="section-heading">
          <span class="work-redesign__section-index">01</span>
          <h2 id="work-profile-title">Path so far</h2>
        </div>
        <div class="work-redesign__profile-grid">
          <Timeline items={workTimelineMock} />
        </div>
      </section>

      <section id="work-systems" class="work-redesign__section work-redesign__section--systems" data-work-section="systems" aria-labelledby="work-systems-title">
        <div class="work-redesign__section-head" data-work-reveal="section-heading">
          <span class="work-redesign__section-index">02</span>
          <h2 id="work-systems-title">Tools I use</h2>
        </div>
        <TechnologyLoops client:load />
      </section>

      <section id="work-projects" class="work-redesign__section" data-work-section="projects" aria-labelledby="work-projects-title">
        <div class="work-redesign__section-head" data-work-reveal="section-heading">
          <span class="work-redesign__section-index">03</span>
          <h2 id="work-projects-title">Selected work</h2>
        </div>
        <ul class="work-redesign__projects">
          {projects.length > 0 ? projects.map((project, index) => (
            <li class="work-redesign__project" data-work-project-row>
              <a href={withBasePath(`/projects/${project.id}`)}>
                <span class="work-redesign__project-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="work-redesign__project-title">{project.title}</span>
                <span class="work-redesign__project-description">{project.description}</span>
                <span class="work-redesign__project-year">{project.year}</span>
                <span class="work-redesign__project-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          )) : (
            <li class="work-redesign__empty">No projects yet.</li>
          )}
        </ul>
      </section>

      <section id="work-experience" class="work-redesign__section work-redesign__section--now" data-work-section="experience" aria-labelledby="work-now-title">
        <div class="work-redesign__section-head" data-work-reveal="section-heading">
          <span class="work-redesign__section-index">04</span>
          <h2 id="work-now-title">Now</h2>
        </div>
        <div class="work-redesign__now-grid">
          <p class="work-redesign__now-title" data-work-reveal="now-title">Building useful things around agents.</p>
          <div class="work-redesign__now-links" data-work-reveal="now-links">
            <a href={withBasePath('/projects')}>Open project index <span aria-hidden="true">↗</span></a>
            <a href={withBasePath('/blog')}>Read the notes <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  import { initWorkPageMotion } from '../features/work/workPageMotion';

  let cleanupWorkPage = () => {};

  const setupWorkPage = () => {
    cleanupWorkPage();
    const page = document.querySelector<HTMLElement>('[data-work-page]');
    cleanupWorkPage = page ? initWorkPageMotion(page) : () => {};
  };

  document.addEventListener('astro:page-load', setupWorkPage);
  document.addEventListener('astro:before-swap', () => cleanupWorkPage());
</script>
