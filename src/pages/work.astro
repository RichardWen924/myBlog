---
import Base from '../layouts/Base.astro';
import FadeSection from '../components/react/FadeSection';
import ProjectCard from '../components/react/ProjectCard';
import SkillsOrbit from '../components/react/SkillsOrbit';
import Timeline from '../components/react/Timeline';
import FutureHero from '../components/react/FutureHero';
import WhoAmIIntro from '../components/react/WhoAmIIntro';
import SectionEyebrow from '../components/home/SectionEyebrow.astro';
import WorkChapterNavigation from '../components/work/WorkChapterNavigation.astro';
import { getProjects } from '../lib/content';
import profile from '../data/profile';
import workTimelineMock from '../data/workTimelineMock';

const projects = getProjects();
---

<Base title="Work" fullBleed htmlClass="work-scroll-snap work-page">
  <div class="work-sequence">
    <section id="work-hero" class="work-chapter work-chapter--hero work-reactive-hero -mt-12" data-work-chapter="hero" data-work-hero-page>
      <FutureHero client:load />
    </section>

    <section id="work-whoami" class="work-chapter work-chapter--whoami" data-work-chapter="whoami">
      <div class="work-whoami-layout mx-auto max-w-6xl px-6">
        <WhoAmIIntro client:visible />
        <FadeSection client:visible className="work-whoami-timeline" delay={1.35}>
          <Timeline client:visible items={workTimelineMock} />
        </FadeSection>
      </div>
    </section>

    <section id="work-systems" class="work-chapter work-chapter--systems work-skill-hero" data-work-chapter="systems">
      <div class="work-skill-layout mx-auto max-w-6xl px-6">
        <div class="work-skill-copy">
          <SectionEyebrow index="02" label="Technical practice" status="WORK / SYSTEMS" />
          <h1 class="mt-10 font-serif text-4xl font-semibold leading-tight text-ink md:text-5xl">
            Systems I build, and the thinking behind them.
          </h1>
          <p class="mt-6 max-w-md text-base leading-relaxed text-ink-soft">
            Backend systems, interfaces and tools shaped by a preference for clarity, resilience and thoughtful details.
          </p>
          <div class="work-skill-signals mt-12">
            <div class="work-skill-signal">
              <span class="font-mono text-xs text-accent">01</span>
              <div><h2 class="font-serif text-xl font-semibold text-ink">Build with clarity</h2><p class="mt-1 text-sm leading-relaxed text-ink-soft">Make complexity easier to understand and maintain.</p></div>
            </div>
            <div class="work-skill-signal">
              <span class="font-mono text-xs text-accent">02</span>
              <div><h2 class="font-serif text-xl font-semibold text-ink">Connect the pieces</h2><p class="mt-1 text-sm leading-relaxed text-ink-soft">Design the boundaries where tools, data and people meet.</p></div>
            </div>
            <div class="work-skill-signal">
              <span class="font-mono text-xs text-accent">03</span>
              <div><h2 class="font-serif text-xl font-semibold text-ink">Keep exploring</h2><p class="mt-1 text-sm leading-relaxed text-ink-soft">Follow the question until the useful pattern appears.</p></div>
            </div>
          </div>
        </div>
        <div class="work-skill-visual">
          <SkillsOrbit client:load />
        </div>
      </div>
    </section>

    <section id="work-projects" class="work-chapter work-chapter--content" data-work-chapter="projects">
      <div class="work-content mx-auto max-w-4xl px-4">
        <section class="work-section">
          <SectionEyebrow index="03" label="Selected work" status="PROJECTS" />
          <FadeSection client:visible className="mt-8">
            {projects.length > 0 ? (
              <ul>
                {projects.map((project, i) => <ProjectCard client:visible project={project} index={i} />)}
              </ul>
            ) : (
              <p class="py-12 text-center font-serif text-lg text-ink-soft">No projects yet.</p>
            )}
          </FadeSection>
        </section>
      </div>
    </section>

    <section id="work-experience" class="work-chapter work-chapter--content" data-work-chapter="experience">
      <div class="work-content mx-auto max-w-4xl px-4">
        <section class="work-section border-t border-border pt-24">
          <SectionEyebrow index="04" label="Experience" status="TIMELINE" />
          <div class="mt-8">
            <Timeline client:visible />
          </div>
        </section>
      </div>
    </section>

    <section id="work-more" class="work-chapter work-chapter--closing" data-work-chapter="more">
      <div class="work-content mx-auto max-w-4xl px-4">
        <section class="work-section border-t border-border pb-24 pt-24">
          <SectionEyebrow index="05" label="Continue exploring" status="DETAILS" />
          <div class="mt-8 flex flex-wrap gap-5">
            <a href="/projects" class="chapter-link font-mono text-sm text-accent no-underline">Open project index <span aria-hidden="true">&rarr;</span></a>
            <a href="/blog" class="chapter-link font-mono text-sm text-accent no-underline">Read the notes <span aria-hidden="true">&rarr;</span></a>
          </div>
        </section>
      </div>
    </section>
  </div>

  <WorkChapterNavigation />
</Base>

<script>
  let cleanupWorkPage = () => {};

  const setupWorkPage = () => {
    cleanupWorkPage();
    const chapters = [...document.querySelectorAll('[data-work-chapter]')];
    const railLinks = [...document.querySelectorAll('[data-work-rail-link]')];
    if (chapters.length === 0 || railLinks.length === 0) return;

    const setActiveChapter = (id) => {
      railLinks.forEach((link) => {
        const isActive = link.dataset.workRailLink === id;
        link.toggleAttribute('data-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'step');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActiveChapter(visible.target.dataset.workChapter);
      },
      { rootMargin: '-25% 0px -55% 0px', threshold: [0.1, 0.35, 0.6] },
    );

    chapters.forEach((chapter) => observer.observe(chapter));
    setActiveChapter(chapters[0]?.dataset.workChapter ?? 'hero');

    const isInteractiveControl = (target) => {
      if (!(target instanceof HTMLElement)) return false;
      return target.isContentEditable
        || ['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON', 'A', 'SUMMARY'].includes(target.tagName)
        || Boolean(target.closest('a, button, summary, [role="button"], [contenteditable="true"]'));
    };

    const getCurrentSectionIndex = () => {
      const marker = window.scrollY + window.innerHeight * 0.35;
      const currentIndex = chapters.findIndex((chapter) => {
        const top = chapter.offsetTop;
        return marker >= top && marker < top + chapter.offsetHeight;
      });

      return currentIndex === -1 ? 0 : currentIndex;
    };

    const handleKeyDown = (event) => {
      if (event.defaultPrevented || !['ArrowDown', 'ArrowUp'].includes(event.key) || isInteractiveControl(event.target)) return;

      const direction = event.key === 'ArrowDown' ? 1 : -1;
      const currentIndex = getCurrentSectionIndex();
      const nextIndex = Math.min(Math.max(currentIndex + direction, 0), chapters.length - 1);
      const nextSection = chapters[nextIndex];

      if (!nextSection || nextIndex === currentIndex) return;

      event.preventDefault();
      const scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      if (nextIndex === 0) {
        window.scrollTo({ top: 0, behavior: scrollBehavior });
      } else {
        nextSection.scrollIntoView({ behavior: scrollBehavior, block: 'start' });
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    cleanupWorkPage = () => {
      observer.disconnect();
      window.removeEventListener('keydown', handleKeyDown);
      cleanupWorkPage = () => {};
    };
  };

  document.addEventListener('astro:page-load', setupWorkPage);
  document.addEventListener('astro:before-swap', () => cleanupWorkPage());
</script>
