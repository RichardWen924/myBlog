---
import Base from '../layouts/Base.astro';
import HeroReactive from '../components/react/HeroReactive';
import FadeSection from '../components/react/FadeSection';
import ProjectCard from '../components/react/ProjectCard';
import PostCard from '../components/home/PostCard.astro';
import profile from '../data/profile';
import { SITE_DESCRIPTION } from '../lib/constants';
import { getPublishedPosts, getFeaturedPosts, getFeaturedProjects } from '../lib/content';

const posts = await getPublishedPosts();
const featuredPosts = getFeaturedPosts(posts);
const featuredProjects = getFeaturedProjects();
---

<Base title="Home" description={SITE_DESCRIPTION}>
  <!-- Hero: React island, full-screen above fold, offsets main's top padding -->
  <div class="-mt-12">
    <HeroReactive client:load name={profile.name} title={profile.title} email={profile.email} />
  </div>

  <!-- Bio: static Astro, zero JS -->
  <FadeSection client:visible className="mt-14">
    <div class="prose prose-gray max-w-none">
      {profile.bio.map((p) => <p>{p}</p>)}
    </div>
  </FadeSection>

  <!-- Featured Projects: React island, hydrate on scroll -->
  {
    featuredProjects.length > 0 && (
      <FadeSection client:visible className="mt-16">
        <h2 class="mb-2 font-serif text-2xl font-bold text-ink">Projects</h2>
        <ul>
          {featuredProjects.map((project, i) => (
            <ProjectCard client:visible project={project} index={i} />
          ))}
        </ul>
        <a href="/projects" class="mt-4 inline-block font-mono text-sm text-accent no-underline">
          View all projects &rarr;
        </a>
      </FadeSection>
    )
  }

  <!-- Recent Posts: pure Astro, zero JS -->
  {
    featuredPosts.length > 0 && (
      <section class="mt-16">
        <h2 class="mb-2 font-serif text-2xl font-bold text-ink">Recent Posts</h2>
        <ul class="divide-y divide-border">
          {featuredPosts.map((post, i) => <PostCard post={post} index={i} />)}
        </ul>
        <a href="/blog" class="mt-4 inline-block font-mono text-sm text-accent no-underline">
          View all posts &rarr;
        </a>
      </section>
    )
  }
</Base>
