---
import Base from '../layouts/Base.astro';
import PostCard from '../components/home/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION, POSTS_PER_PAGE } from '../lib/constants';
import { getPublishedPosts } from '../lib/content';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, POSTS_PER_PAGE);
---

<Base title="Home" description={SITE_DESCRIPTION}>
  <section class="pb-4 pt-8">
    <h1 class="font-serif text-3xl font-bold text-ink">{SITE_TITLE}</h1>
    <p class="mt-3 text-ink-soft">{SITE_DESCRIPTION}</p>
  </section>

  {
    recentPosts.length > 0 ? (
      <ul class="divide-y divide-border">
        {recentPosts.map((post, i) => <PostCard post={post} index={i} />)}
      </ul>
    ) : (
      <p class="py-12 text-center font-serif text-lg text-ink-soft">
        Posts coming soon.
      </p>
    )
  }
</Base>
