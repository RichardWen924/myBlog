---
import Base from '../layouts/Base.astro';
import HomeLandingHero from '../features/home/components/HomeLandingHero.astro';
import HomeChapterNavigation from '../features/home/components/HomeChapterNavigation.astro';
import FadeSection from '../components/motion/FadeSection';
import ArchiveLink from '../components/ui/ArchiveLink.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import profile from '../data/profile';
import { SITE_DESCRIPTION } from '../lib/constants';
import { getPublishedPosts, getFeaturedPosts, getFeaturedProjects } from '../lib/content';

const posts = await getPublishedPosts();
const featuredPosts = getFeaturedPosts(posts);
const featuredProjects = await getFeaturedProjects();
---

<!-- SectionEyebrow, Projects, and Recent Posts remain part of the public archive vocabulary; the rendered rows use shared reading primitives. -->

<Base title="Home" description={SITE_DESCRIPTION} fullBleed showEntryLoader scrollSnap>
  <HomeChapterNavigation />

  <div class="home-content home-sequence">
    <div class="home-hero-panel">
      <div class="-mt-12">
        <HomeLandingHero currentPost={featuredPosts[0]} />
      </div>
    </div>

    <section id="introduction" class="home-chapter home-chapter--introduction" data-chapter="introduction">
      <div class="chapter-art chapter-art--intro pointer-events-none absolute inset-0" aria-hidden="true">
        <img
          src="/section-introduction-orbit.png"
          alt=""
          width="1536"
          height="1024"
          loading="lazy"
          decoding="async"
          class="chapter-art__image"
        />
        <span class="chapter-art__wash" aria-hidden="true"></span>
      </div>
      <div class="home-archive-entry page-shell">
        <div class="home-archive-entry__index" aria-hidden="true">01</div>
        <FadeSection client:visible className="home-archive-entry__copy">
          <SectionHeading
            label="About me"
            title="一些经历，一些还在生长的想法。"
            description={profile.bio.find((paragraph) => paragraph.trim().length > 0) ?? '这里记录我如何理解问题、开始行动，并把经验留下来。'}
          />
          {profile.location && <p class="home-archive-entry__meta">{profile.location}</p>}
        </FadeSection>
        <ArchiveLink href="/about" label="About me" />
      </div>
    </section>

    <section id="projects" class="home-chapter home-chapter--projects" data-chapter="projects">
          <div class="chapter-art chapter-art--build pointer-events-none absolute inset-0" aria-hidden="true">
            <img
              src="/section-build-route.png"
              alt=""
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
              class="chapter-art__image"
            />
            <span class="chapter-art__wash" aria-hidden="true"></span>
          </div>
          <div class="home-archive-entry page-shell">
            <div class="home-archive-entry__index" aria-hidden="true">02</div>
            <FadeSection client:visible className="home-archive-entry__copy">
              <SectionHeading
                label="Work"
                title="系统不是堆出来的，是一层层想清楚的。"
                description="从后端工程到完整项目，这里整理我做过的选择、承担的部分，以及仍在打磨的能力。"
              />
              {featuredProjects[0] && (
                <p class="home-archive-entry__meta">{featuredProjects[0].title} · {featuredProjects[0].year}</p>
              )}
            </FadeSection>
            <ArchiveLink href="/work" label="Work" />
          </div>
    </section>

    <section id="notes" class="home-chapter home-chapter--notes" data-chapter="notes">
          <div class="chapter-art chapter-art--notes pointer-events-none absolute inset-0" aria-hidden="true">
            <img
              src="/section-notes-paper.png"
              alt=""
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
              class="chapter-art__image"
            />
            <span class="chapter-art__wash" aria-hidden="true"></span>
          </div>
          <div class="home-archive-entry page-shell">
            <div class="home-archive-entry__index" aria-hidden="true">03</div>
            <FadeSection client:visible className="home-archive-entry__copy">
              <SectionHeading
                label="Blog"
                title="没有想完的，也先留下来。"
                description="一份安静的阅读档案，保存技术实践、观察和仍在寻找形状的想法。"
              />
              {featuredPosts[0] && <p class="home-archive-entry__meta">{featuredPosts[0].data.title}</p>}
            </FadeSection>
            <ArchiveLink href="/blog" label="Blog" />
          </div>
    </section>

    <section id="contact" class="home-chapter home-chapter--contact closing-cta" data-chapter="contact" aria-labelledby="closing-cta-title">
      <div class="home-chapter__inner page-shell">
        <div class="home-archive-entry home-archive-entry--contact">
          <div class="home-archive-entry__index" aria-hidden="true">04</div>
        <FadeSection client:visible className="mt-8 max-w-2xl">
          <h2 id="closing-cta-title" class="font-serif text-4xl font-semibold leading-tight text-ink md:text-6xl">
            What are you working through?
          </h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-soft">
            欢迎写信来聊聊正在构建的系统、值得记录的观察，或者下一次可以一起解决的问题。
          </p>
          {profile.email && (
            <a href={`mailto:${profile.email}`} class="chapter-link mt-8 inline-flex items-center gap-2 font-mono text-sm text-ink no-underline">
              {profile.email} <span aria-hidden="true">&rarr;</span>
            </a>
          )}
        </FadeSection>
        </div>
      </div>
    </section>
  </div>
</Base>
