---
import Base from '../layouts/Base.astro';
import ArchiveLink from '../components/ui/ArchiveLink.astro';
import ContentDivider from '../components/ui/ContentDivider.astro';
import MotionReveal from '../components/ui/MotionReveal.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import HeroReactive from '../features/about/components/HeroReactive';
import experience from '../data/experience';
import profile from '../data/profile';

const bio = profile.bio.filter((paragraph) => paragraph.trim().length > 0);
const verifiedExperience = experience.filter((item) => {
  const organization = item.organization.toLowerCase();
  return !/your company|your organization|placeholder|example/.test(organization);
});
const socialLinks = Object.entries(profile.socials).filter(
  ([label, href]): href is string => label !== 'email' && typeof href === 'string',
);

const formatDate = (value: string) => {
  const [year, month] = value.split('-');
  return month ? `${year}.${month}` : year;
};
---

<Base title="About" fullBleed lang="zh-CN">
  <div class="about-page">
    <section id="now" data-about-section="now" class="about-section about-section--now">
      <div class="about-reactive-hero -mt-12">
        <HeroReactive client:load name={profile.name} title={profile.title} email={profile.email} scrollTarget="#the-path" />
      </div>

      <div class="page-shell about-section__inner about-now__inner">
        <MotionReveal>
          <div class="about-now__columns">
            <p class="about-statement">我更愿意把自己看作一个独立创造者：保持好奇，把想法做出来，也给还没想完的事情留一点空间。</p>
            <div class="about-profile-copy">
              <p class="about-profile-copy__title">{profile.title}</p>
              <div class="about-hero-note">
                <p class="about-hero-note__statement">慢一点，事情会开始露出自己的形状。</p>
                {profile.location && <p class="about-hero-note__location">{profile.location}</p>}
              </div>
              {bio.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>
        </MotionReveal>
      </div>
    </section>

    <ContentDivider />

    <section id="the-path" data-about-section="the-path" class="about-section about-section--path">
      <div class="page-shell about-section__inner">
        <SectionHeading
          index="01"
          label="The path"
          title="成长不是一条直线。"
          description="只保留已经发生、也能够被确认的节点；缺少真实内容的地方，就先留白。"
        />

        <MotionReveal>
          {verifiedExperience.length > 0 ? (
            <ol class="about-growth-path" aria-label="Verified growth path">
              {verifiedExperience.map((item) => (
                <li class="about-path__item">
                  <div class="about-path__meta">
                    <span>{formatDate(item.startDate)}</span>
                    {item.endDate && <span>— {formatDate(item.endDate)}</span>}
                  </div>
                  <div class="about-path__content">
                    <h3>{item.title}</h3>
                    <p class="about-path__organization">{item.organization}</p>
                    {item.description.map((description) => <p>{description}</p>)}
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <div class="about-growth-path about-growth-path--empty">
              <p class="about-empty">这条路径还在补充中。下一段真实经历，会在发生之后留在这里。</p>
            </div>
          )}
        </MotionReveal>
      </div>
    </section>

    <ContentDivider />

    <section id="how-i-keep-growing" data-about-section="how-i-keep-growing" class="about-section about-section--practice">
      <div class="page-shell about-section__inner">
        <SectionHeading
          index="02"
          label="How I keep growing"
          title="把注意力放回过程。"
          description="一些简单的习惯，帮助我在做事、记录和继续提问之间保持联系。"
        />

        <MotionReveal>
          <div class="about-practice-grid">
            <article>
              <h3>Notice the details</h3>
              <p>Small observations often decide how a larger idea finds its shape.</p>
            </article>
            <article>
              <h3>Keep a trail</h3>
              <p>Notes make room for unfinished thoughts to become useful later.</p>
            </article>
            <article>
              <h3>Stay curious</h3>
              <p>The best direction is often found by following a question a little further.</p>
            </article>
          </div>
        </MotionReveal>
      </div>
    </section>

    <ContentDivider />

    <section id="elsewhere" data-about-section="elsewhere" class="about-section about-section--elsewhere">
      <div class="page-shell about-section__inner">
        <SectionHeading
          index="03"
          label="Elsewhere"
          title="从不同入口，继续认识我。"
          description="技术之外的生活会慢慢留下痕迹；工作和文章，则记录我如何把问题变成行动。"
        />

        <MotionReveal>
          <div class="about-elsewhere__layout">
            <p class="about-statement about-statement--small">没有想完的，也先留下来。</p>
            <nav class="about-elsewhere__links" aria-label="Personal archive links">
              {socialLinks.map(([label, href]) => (
                <ArchiveLink href={href} label={label === 'github' ? 'GitHub' : label} external={href.startsWith('http')} />
              ))}
              {profile.email && <ArchiveLink href={`mailto:${profile.email}`} label="Email" />}
              <ArchiveLink href="/work" label="Work" />
              <ArchiveLink href="/blog" label="Blog" />
            </nav>
          </div>
        </MotionReveal>
      </div>
    </section>
  </div>
</Base>
