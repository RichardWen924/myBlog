---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/ui/BackLink.astro';
import { getProjects } from '../../lib/content';
import type { Project } from '../../data/projects';

export function getStaticPaths() {
  return getProjects().map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<Base title={project.title} description={project.description}>
  <article class="pt-16 pb-8">
    <BackLink href="/projects" label="Projects" />
    <div class="mt-6 flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h1 class="font-serif text-3xl font-bold leading-tight text-ink">
        {project.title}
      </h1>
      <span class="font-mono text-xs text-ink-soft/70">{project.year}</span>
    </div>

    <p class="mt-6 text-ink-soft">
      {project.longDescription ?? project.description}
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
      {project.technologies.map((tech) => (
        <span class="font-mono text-xs text-accent">#{tech}</span>
      ))}
    </div>

    <div class="mt-8 flex gap-6 border-t border-border pt-6">
      {project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener"
          class="font-mono text-sm text-accent no-underline"
        >
          Live site &rarr;
        </a>
      )}
      {project.repo && (
        <a
          href={project.repo}
          target="_blank"
          rel="noopener"
          class="font-mono text-sm text-accent no-underline"
        >
          Source &rarr;
        </a>
      )}
    </div>
  </article>
</Base>
