---
import Base from '../../layouts/Base.astro';
import YearGroup from '../../components/YearGroup.astro';
import { getPublishedPosts } from '../../lib/content';
import { groupByYear } from '../../lib/utils';

const posts = await getPublishedPosts();
const yearGroups = groupByYear(posts);
---

<Base title="Archive">
  <h1 class="mb-8 pt-8 font-serif text-3xl font-bold text-ink">Archive</h1>
  {
    yearGroups.size > 0 ? (
      [...yearGroups.entries()].map(([year, yearPosts]) => (
        <YearGroup year={year} posts={yearPosts} />
      ))
    ) : (
      <p class="py-12 text-center font-serif text-lg text-ink-soft">
        No posts yet.
      </p>
    )
  }
</Base>
