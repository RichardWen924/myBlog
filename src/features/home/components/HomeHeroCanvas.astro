---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../../lib/utils';
import { withBasePath } from '../../../lib/sitePath';

interface Props {
  currentPost?: CollectionEntry<'blog'> | undefined;
}

const { currentPost } = Astro.props;
const currentContentHref = withBasePath(currentPost ? `/blog/${currentPost.id}` : '/blog');
const currentContentTitle = currentPost?.data.title ?? 'Read the notes';
const currentContentDescription = currentPost?.data.description ?? 'A quiet archive of ideas still finding their shape.';
---

<div class="home-landing-hero__workspace" data-home-hero-workspace>
  <div class="home-landing-hero__workspace-glow" aria-hidden="true"></div>

  <div class="home-landing-hero__route-layer" aria-hidden="true">
    <svg class="home-landing-hero__routes" viewBox="0 0 640 640" fill="none">
      <path
        class="home-landing-hero__route home-landing-hero__route--sage"
        data-home-hero-route
        d="M42 92C178 230 238 202 326 134C414 66 526 98 656 226"
      />
    </svg>

    <span class="home-landing-hero__node home-landing-hero__node--one"></span>
    <span class="home-landing-hero__node home-landing-hero__node--two"></span>
  </div>

  <div class="home-landing-hero__paper-stack" data-home-hero-paper-stack>
    <div class="home-landing-hero__paper home-landing-hero__paper--back" aria-hidden="true"></div>
    <div class="home-landing-hero__paper home-landing-hero__paper--middle" aria-hidden="true"></div>
    <article class="home-landing-hero__paper home-landing-hero__paper--front" data-home-hero-paper>
      <div class="home-landing-hero__paper-header">
        <span>Latest note</span>
        {currentPost && <time datetime={currentPost.data.date.toISOString()}>{formatDate(currentPost.data.date)}</time>}
      </div>

      <a href={currentContentHref} class="home-landing-hero__current-content" data-home-hero-current-link>
        <h2>{currentContentTitle}</h2>
        <p>{currentContentDescription}</p>
        <span class="home-landing-hero__current-arrow" aria-hidden="true">↗</span>
      </a>

    </article>
  </div>
</div>
