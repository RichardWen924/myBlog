---
import profile from '../../../data/profile';
import { withBasePath } from '../../../lib/sitePath';
import { WELCOME_WORDS } from '../homeHero';

const routes = [
  { label: 'About', href: withBasePath('/about') },
  { label: 'Work', href: withBasePath('/work') },
  { label: 'Blog', href: withBasePath('/blog') },
] as const;

const contactHref = profile.email ? `mailto:${profile.email}` : withBasePath('/about');
---

<section class="quiet-hero" data-home-landing-hero aria-labelledby="quiet-hero-title">
  <h1 id="quiet-hero-title" class="sr-only">Welcome to Richard's personal archive</h1>

  <div class="quiet-hero__frame">
    <header class="quiet-hero__topbar" data-home-frame-top>
      <a class="quiet-hero__brand" href={withBasePath('/')} aria-label="Richard, home">Richard</a>
      <a class="quiet-hero__contact" href={contactHref}>
        <span>Contact</span>
        <span aria-hidden="true">↗</span>
      </a>
    </header>

    <div class="quiet-hero__main">
      <div class="quiet-hero__welcome" data-home-welcome>
        <div class="quiet-hero__orbit" data-home-orbit aria-hidden="true">
          <span class="quiet-hero__orbit-track" data-home-orbit-marker-track>
            <i class="quiet-hero__orbit-marker"></i>
          </span>
        </div>

        <div class="quiet-hero__greeting-window" aria-hidden="true" data-home-greeting-window>
          {WELCOME_WORDS.map((word, index) => (
            <span
              class="quiet-hero__greeting"
              lang={word.lang}
              data-home-greeting-item
              data-greeting-active={index === 0 ? '' : undefined}
            >
              {word.label}
            </span>
          ))}
        </div>

        <p class="quiet-hero__identity" data-home-identity>Richard.</p>

        <div class="quiet-hero__counter" data-home-counter>
          <span data-home-greeting-index>01</span>
          <span aria-hidden="true">/</span>
          <span>{String(WELCOME_WORDS.length).padStart(2, '0')}</span>
          <i aria-hidden="true"></i>
        </div>
      </div>

      <nav class="quiet-hero__routes" aria-label="Explore Richard's archive" data-home-routes>
        {routes.map((route) => (
          <a class="quiet-hero__route" href={route.href} data-home-route>
            <span class="quiet-hero__route-label" data-home-route-label>{route.label}</span>
            <span class="quiet-hero__route-arrow" data-home-route-arrow aria-hidden="true">↗</span>
            <i class="quiet-hero__route-line" data-home-route-line aria-hidden="true"></i>
          </a>
        ))}
      </nav>
    </div>

    <footer class="quiet-hero__footer" data-home-frame-footer>
      <span>Shanghai · 2026</span>
    </footer>
  </div>
</section>

<script>
  import { initHomeHeroMotion } from '../homeHeroMotion';

  let cleanupHomeHero = () => {};

  const setupHomeHero = () => {
    cleanupHomeHero();
    const cleanups = Array.from(document.querySelectorAll<HTMLElement>('[data-home-landing-hero]'))
      .map((hero) => initHomeHeroMotion(hero));

    cleanupHomeHero = () => {
      cleanups.forEach((cleanup) => cleanup());
      cleanupHomeHero = () => {};
    };
  };

  document.addEventListener('astro:page-load', setupHomeHero);
  document.addEventListener('astro:before-swap', () => cleanupHomeHero());
</script>
