<nav class="home-chapter-rail" data-home-chapter-rail aria-label="Homepage chapters">
  <a href="#introduction" data-rail-link="introduction" aria-label="Introduction"><span>01</span></a>
  <a href="#projects" data-rail-link="projects" aria-label="Projects"><span>02</span></a>
  <a href="#notes" data-rail-link="notes" aria-label="Notes"><span>03</span></a>
  <a href="#contact" data-rail-link="contact" aria-label="Contact"><span>04</span></a>
</nav>

<script>
  let cleanupHomeNavigation = () => {};

  const setupHomeNavigation = () => {
    cleanupHomeNavigation();
    const rail = document.querySelector<HTMLElement>('[data-home-chapter-rail]');
    const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
    const railLinks = [...document.querySelectorAll<HTMLElement>('[data-rail-link]')];
    if (!rail || chapters.length === 0 || railLinks.length === 0) return;

    const setActiveChapter = (id: string) => {
      railLinks.forEach((link) => {
        const isActive = link.dataset.railLink === id;
        link.toggleAttribute('data-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'step');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActiveChapter((visible.target as HTMLElement).dataset.chapter ?? 'introduction');
      },
      { rootMargin: '-25% 0px -55% 0px', threshold: [0.1, 0.35, 0.6] },
    );

    chapters.forEach((chapter) => observer.observe(chapter));
    setActiveChapter(chapters[0]?.dataset.chapter ?? 'introduction');

    const homeHero = document.querySelector<HTMLElement>('.home-landing-hero');
    const homeSections = [homeHero, ...chapters].filter(
      (section): section is HTMLElement => Boolean(section),
    );

    const isTextControl = (target: EventTarget | null) => {
      if (!(target instanceof HTMLElement)) return false;
      return target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName);
    };

    const getCurrentSectionIndex = () => {
      const marker = window.scrollY + window.innerHeight * 0.35;
      const currentIndex = homeSections.findIndex((section) => {
        const top = section.offsetTop;
        return marker >= top && marker < top + section.offsetHeight;
      });

      return currentIndex === -1 ? 0 : currentIndex;
    };

    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.defaultPrevented || !['ArrowDown', 'ArrowUp'].includes(event.key) || isTextControl(event.target)) return;

      const direction = event.key === 'ArrowDown' ? 1 : -1;
      const currentIndex = getCurrentSectionIndex();
      const nextIndex = Math.min(Math.max(currentIndex + direction, 0), homeSections.length - 1);
      const nextSection = homeSections[nextIndex];

      if (!nextSection || nextIndex === currentIndex) return;

      event.preventDefault();
      const scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      if (nextSection === homeHero) {
        window.scrollTo({ top: 0, behavior: scrollBehavior });
      } else {
        nextSection.scrollIntoView({ behavior: scrollBehavior, block: 'start' });
      }
    };

    window.addEventListener('keydown', handleKeyDown);

    cleanupHomeNavigation = () => {
      observer.disconnect();
      window.removeEventListener('keydown', handleKeyDown);
      cleanupHomeNavigation = () => {};
    };
  };

  document.addEventListener('astro:page-load', setupHomeNavigation);
  document.addEventListener('astro:before-swap', () => cleanupHomeNavigation());
</script>
