---
import { formatDate } from '../lib/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  year: number;
  posts: CollectionEntry<'blog'>[];
}
const { year, posts } = Astro.props;
---

<section class="mb-12">
  <h2 class="mb-6 font-serif text-2xl font-bold text-ink">{year}</h2>
  <ul class="divide-y divide-border">
    {posts.map((post) => (
      <li class="blog-archive-row">
        <a
          href={`/blog/${post.id}`}
          class="blog-archive-row__link group no-underline"
        >
          <span class="blog-archive-row__main">
            <span class="blog-archive-row__title">{post.data.title}</span>
            {
              post.data.tags.length > 0 && (
                <span class="blog-archive-row__tags" aria-label="Tags">
                  {post.data.tags.map((tag) => <span>#{tag}</span>)}
                </span>
              )
            }
          </span>
          <time datetime={post.data.date.toISOString()} class="blog-archive-row__date">
            {formatDate(post.data.date)}
          </time>
          {
            post.data.image && (
              <span class="blog-archive-row__media">
                <img src={post.data.image} alt={post.data.title} loading="lazy" />
              </span>
            )
          }
        </a>
      </li>
    ))}
  </ul>
</section>
