---
import '../../styles/work-theme-transition.css';
---

<div data-work-theme-transition transition:persist="work-theme-transition">
  <div class="work-theme-transition__backdrop" aria-hidden="true"></div>

  <div
    class="work-theme-transition__direct-source"
    data-work-transition-direct-source
    aria-hidden="true"
  >
    <div class="work-theme-transition__paper-grid"></div>
    <div class="work-theme-transition__source-copy">
      <small>RICHARD / ARCHIVE</small>
      <strong>Ideas made<br />tangible.</strong>
    </div>
  </div>

  <div
    class="work-theme-transition__target"
    data-work-transition-target
    aria-hidden="true"
    inert
  ></div>

  <div class="work-theme-transition__streaks" aria-hidden="true"></div>
  <div class="work-theme-transition__focus" aria-hidden="true">
    <i class="work-theme-transition__focus-glow"></i>
    <i class="work-theme-transition__focus-ring"></i>
  </div>
</div>

<script>
  import { initWorkThemeTransition } from './workThemeTransitionClient';

  initWorkThemeTransition();
</script>
