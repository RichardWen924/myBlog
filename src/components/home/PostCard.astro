---
import { formatDate } from '../../lib/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
}
const { post, index = 0 } = Astro.props;
---

<li class="post-row group py-5 animate-reveal" style={`animation-delay: ${index * 80}ms`}>
  <a href={`/blog/${post.id}`} class="group block no-underline">
    <h2 class="font-serif text-lg font-semibold leading-snug text-ink">
      {post.data.title}
    </h2>
    <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">
      {post.data.description}
    </p>
    <div class="mt-2 flex items-center gap-3">
      <time datetime={post.data.date.toISOString()} class="font-mono text-xs text-ink-soft/60">
        {formatDate(post.data.date)}
      </time>
      {post.data.tags.slice(0, 2).map((tag) => (
        <span class="font-mono text-xs text-accent/60">#{tag}</span>
      ))}
      <span class="post-row__arrow ml-auto font-mono text-sm text-accent opacity-0 transition-all duration-200 group-hover:translate-x-1 group-hover:opacity-100" aria-hidden="true">
        &rarr;
      </span>
    </div>
  </a>
</li>
