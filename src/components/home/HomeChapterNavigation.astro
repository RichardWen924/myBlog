<nav class="home-chapter-rail" aria-label="Homepage chapters">
  <a href="#introduction" data-rail-link="introduction" aria-label="Introduction"><span>01</span></a>
  <a href="#projects" data-rail-link="projects" aria-label="Projects"><span>02</span></a>
  <a href="#notes" data-rail-link="notes" aria-label="Notes"><span>03</span></a>
  <a href="#contact" data-rail-link="contact" aria-label="Contact"><span>04</span></a>
</nav>

<script>
  const chapters = [...document.querySelectorAll('[data-chapter]')];
  const railLinks = [...document.querySelectorAll('[data-rail-link]')];

  const setActiveChapter = (id) => {
    railLinks.forEach((link) => {
      const isActive = link.dataset.railLink === id;
      link.toggleAttribute('data-active', isActive);
      link.setAttribute('aria-current', isActive ? 'step' : 'false');
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible) setActiveChapter(visible.target.dataset.chapter);
    },
    { rootMargin: '-25% 0px -55% 0px', threshold: [0.1, 0.35, 0.6] },
  );

  chapters.forEach((chapter) => observer.observe(chapter));
  setActiveChapter(chapters[0]?.dataset.chapter ?? 'introduction');

  const homeHero = document.querySelector('.home-landing-hero');
  const homeSections = [homeHero, ...chapters].filter(Boolean);

  const isTextControl = (target) => {
    if (!(target instanceof HTMLElement)) return false;
    return target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName);
  };

  const getCurrentSectionIndex = () => {
    const marker = window.scrollY + window.innerHeight * 0.35;
    const currentIndex = homeSections.findIndex((section) => {
      const top = section.offsetTop;
      return marker >= top && marker < top + section.offsetHeight;
    });

    return currentIndex === -1 ? 0 : currentIndex;
  };

  const handleKeyDown = (event) => {
    if (event.defaultPrevented || !['ArrowDown', 'ArrowUp'].includes(event.key) || isTextControl(event.target)) return;

    const direction = event.key === 'ArrowDown' ? 1 : -1;
    const currentIndex = getCurrentSectionIndex();
    const nextIndex = Math.min(Math.max(currentIndex + direction, 0), homeSections.length - 1);
    const nextSection = homeSections[nextIndex];

    if (!nextSection || nextIndex === currentIndex) return;

    event.preventDefault();
    if (nextSection === homeHero) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      nextSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };

  window.addEventListener('keydown', handleKeyDown);

  document.addEventListener('astro:before-swap', () => {
    observer.disconnect();
    window.removeEventListener('keydown', handleKeyDown);
  }, { once: true });
</script>
