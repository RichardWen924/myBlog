---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import EntryProgressLoader from '../components/entry/EntryProgressLoader.astro';
import WorkTransitionProgress from '../components/entry/WorkTransitionProgress.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../lib/constants';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  fullBleed?: boolean;
  showEntryLoader?: boolean;
  showWorkTransition?: boolean;
  scrollSnap?: boolean;
  htmlClass?: string;
}
const {
  title,
  description = SITE_DESCRIPTION,
  lang = 'en',
  fullBleed = false,
  showEntryLoader = false,
  showWorkTransition = false,
  scrollSnap = false,
  htmlClass = '',
} = Astro.props;
const pageTitle = `${title} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang={lang}
  class:list={[htmlClass, { 'home-scroll-snap': scrollSnap }]}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="relative min-h-screen bg-paper text-ink antialiased">
    <!-- Ambient warm glow, always present, behind all content -->
    <div class="glow-layer" aria-hidden="true"></div>

    <div class="relative z-10">
      {showEntryLoader && <EntryProgressLoader />}
      {showWorkTransition && <WorkTransitionProgress />}
      <div data-entry-content>
        <Header />
        <main class={fullBleed ? 'w-full py-12' : 'mx-auto max-w-4xl px-4 py-12'}>
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
