---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import EntryProgressLoader from '../components/entry/EntryProgressLoader.astro';
import WorkThemeTransition from '../components/entry/WorkThemeTransition.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../lib/constants';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  fullBleed?: boolean;
  showEntryLoader?: boolean;
  scrollSnap?: boolean;
  htmlClass?: string;
  workHeroArrival?: boolean;
}
const {
  title,
  description = SITE_DESCRIPTION,
  lang = 'en',
  fullBleed = false,
  showEntryLoader = false,
  scrollSnap = false,
  htmlClass = '',
  workHeroArrival = false,
} = Astro.props;
const pageTitle = `${title} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang={lang}
  class:list={[htmlClass, { 'home-scroll-snap': scrollSnap }]}
  data-work-hero-arrival={workHeroArrival ? 'pending' : undefined}
  transition:animate="none"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter fallback="animate" />
  </head>
  <body class="relative min-h-screen bg-paper text-ink antialiased">
    <div data-site-page>
      <!-- Ambient warm glow, always present, behind all content -->
      <div class="glow-layer" aria-hidden="true"></div>

      <div class="relative z-10" data-site-visual>
        {showEntryLoader && <EntryProgressLoader />}
        <div data-entry-content>
          <Header />
          <main class={fullBleed ? 'w-full py-12' : 'mx-auto max-w-4xl px-4 py-12'}>
            <slot />
          </main>
          <Footer />
        </div>
      </div>
    </div>
    <WorkThemeTransition />
    <script>
      import { ENTRY_PROGRESS_SESSION_KEY } from '../lib/uiEvents';

      document.addEventListener('astro:before-preparation', () => {
        try {
          window.sessionStorage.setItem(ENTRY_PROGRESS_SESSION_KEY, 'true');
        } catch {
          // Storage may be unavailable; navigation and both transitions still fail open.
        }
      });
    </script>
  </body>
</html>
