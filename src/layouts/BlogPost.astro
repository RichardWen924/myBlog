---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/utils';
import BackLink from '../components/ui/BackLink.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, date, tags } = post.data;
---

<Base title={title} description={description}>
  <article>
    <header class="pt-16 pb-8">
      <BackLink />
      <h1 class="mt-6 font-serif text-3xl font-bold leading-tight text-ink">
        {title}
      </h1>
      <div class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-2 text-sm text-ink-soft">
        <time datetime={date.toISOString()} class="font-mono">
          {formatDate(date)}
        </time>
      </div>
      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="font-mono text-xs text-accent">#{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose prose-gray max-w-none pt-8">
      <slot />
    </div>

    <footer class="mt-16 border-t border-border pt-8">
      <BackLink />
    </footer>
  </article>
</Base>
